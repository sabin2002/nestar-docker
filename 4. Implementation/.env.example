# Copy to .env (next to compose.yaml) to override defaults.

# JWT secret shared by api-gateway (verifies tokens) and member-service (creates tokens).
SECRET_TOKEN=change-me-to-a-long-random-string

# Ollama model for the AI assistant. Smaller = faster on CPU:
#   llama3.2:1b (~1.3 GB, fastest)   llama3.2 (~2 GB, default)   qwen2.5:7b (~4.7 GB, better answers)
OLLAMA_MODEL=llama3.2

# Using Ollama installed directly on Windows/macOS instead of the ollama container:
# OLLAMA_URL=http://host.docker.internal:11434
